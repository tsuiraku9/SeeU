# Generate a private .env with .\scripts\init-env.ps1; do not commit it.
# Optional. Leave empty to generate a random token at application startup.
# The application writes it atomically to data/state/webui-login-token.txt
# with restrictive permissions; it never writes the token value to logs.
# Configure at least 24 printable characters as a strong, stable token for
# persistent deployments (a random 32-byte token is recommended).
WEBUI_LOGIN_TOKEN=
# Required. The initialization scripts generate this value.
SESSION_SECRET=
COOKIE_SECURE=false
# Optional host publication address. Keep the loopback default unless remote
# access is intentional. Set 0.0.0.0, ::, or a specific interface address to
# publish remotely, and protect that deployment with TLS and a firewall/VPN.
APP_BIND_ADDRESS=127.0.0.1
WEBUI_PORT=8080
# APP_PORT is deprecated. Existing .env files still use it as a fallback when
# WEBUI_PORT is absent; new configurations should use WEBUI_PORT only.
# Optional external provider implementing docs/provider-http-contract.md.
# Leave both values empty to run SeeU without an external provider. When SeeU
# runs in Docker and the provider runs on the host, use for example:
# PROVIDER_BASE_URL=http://host.docker.internal:8090
PROVIDER_BASE_URL=
# Required together with PROVIDER_BASE_URL. Use the same random value in the
# external provider, with at least 24 printable characters.
PROVIDER_API_TOKEN=
PROVIDER_REQUEST_TIMEOUT_SECONDS=900
PROVIDER_DISCOVERY_LIMIT=10
# Provider jobs are serialized by default. Raise only after verifying the
# independently deployed provider's CPU/RAM headroom.
PROVIDER_POLL_CONCURRENCY=1
# Enable only when the host uses Clash/Mihomo Fake-IP DNS. Only the standard
# Fake-IP ranges are accepted; other private, loopback, and link-local
# destinations remain blocked.
ALLOW_FAKE_IP_DNS=false
DOWNLOAD_PROCESS_TIMEOUT_SECONDS=900
MEDIA_MAX_BYTES=2147483648
IMPORT_MAX_BYTES=2147483648
IMPORT_MAX_FILES=100
# Hard container fail-safe. Oversized imports/provider downloads remain pending.
ARCHIVE_MEMORY_LIMIT=2g
POLL_INTERVAL_MINUTES=60
POLL_JITTER_MINUTES=5
MIN_FREE_DISK_GB=5
SCHEDULER_ENABLED=true
TZ=Asia/Hong_Kong
