# Generate a private .env with .\scripts\init-env.ps1; do not commit it.
# Optional. Leave empty to generate a random token at application startup.
# The application writes it atomically to data/state/webui-login-token.txt
# with restrictive permissions; it never writes the token value to logs.
# Configure at least 24 printable characters as a strong, stable token for
# persistent deployments (a random 32-byte token is recommended).
WEBUI_LOGIN_TOKEN=
# Required. The initialization scripts generate this value.
SESSION_SECRET=
COOKIE_SECURE=false
# The application container refuses non-loopback publication. Use a local
# reverse proxy, VPN, or SSH tunnel for remote administration.
APP_BIND_ADDRESS=127.0.0.1
WEBUI_PORT=8080
# APP_PORT is deprecated. Existing .env files still use it as a fallback when
# WEBUI_PORT is absent; new configurations should use WEBUI_PORT only.
# noVNC has no application login of its own. Keep this address loopback-only;
# NOVNC_PORT changes the host-published port (the container stays on 7900).
NOVNC_BIND_ADDRESS=127.0.0.1
NOVNC_PORT=7900
CRAWLER_PROVIDER_ENABLED=true
CRAWLER_REQUEST_TIMEOUT_SECONDS=900
CRAWLER_DISCOVERY_LIMIT=500
DISCOVER_TIMEOUT_SECONDS=840
STAGE_TIMEOUT_SECONDS=840
LOGIN_TIMEOUT_SECONDS=600
MANUAL_VERIFICATION_TIMEOUT_SECONDS=480
DOWNLOAD_PROCESS_TIMEOUT_SECONDS=900
MEDIA_MAX_BYTES=2147483648
IMPORT_MAX_BYTES=2147483648
IMPORT_MAX_FILES=100
# Hard container fail-safes. Oversized provider jobs fail and remain pending.
ARCHIVE_MEMORY_LIMIT=2g
CRAWLER_MEMORY_LIMIT=3g
POLL_INTERVAL_MINUTES=60
POLL_JITTER_MINUTES=5
MIN_FREE_DISK_GB=5
SCHEDULER_ENABLED=true
TZ=Asia/Hong_Kong
